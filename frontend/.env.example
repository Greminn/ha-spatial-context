# Used as the remote target for `rsync user@host:path` (see push.mjs) —
# SSH is the transport, so this needs to be something `ssh` can resolve:
# either an alias from ~/.ssh/config, or a literal user@host/user@ip.
HA_HOST=user@homeassistant.local

# Absolute path on HA where the built panel JS is rsynced for fast dev
# iteration. Must end with a slash — this is the integration's own
# already-deployed www/ directory, since the panel is served from its
# own static path (not a versioned Lovelace resource), so a hard
# browser refresh picks up changes with no HA restart needed.
HA_DEV_PATH=/config/custom_components/spatial_context/www/
