{
  "name": "spatial-context-panel",
  "version": "0.4.0-beta.2",
  "description": "Sidebar panel frontend for the Spatial Context Home Assistant integration",
  "author": "Greminn",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Greminn/ha-spatial-context.git"
  },
  "scripts": {
    "build": "rollup -c",
    "build:watch": "rollup -c -w",
    "dev": "concurrently -k -n build,sync 'npm:build:watch' 'npm:push:watch'",
    "push": "node scripts/dev/push.mjs",
    "push:watch": "node scripts/dev/push.mjs --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "dependencies": {
    "@mdi/js": "^7.4.47",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.1",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.1",
    "eslint-plugin-lit": "^2.3.1",
    "eslint-plugin-wc": "^3.1.0",
    "globals": "^17.6.0",
    "prettier": "^3.3.3",
    "rollup": "^4.61.0",
    "tslib": "^2.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
